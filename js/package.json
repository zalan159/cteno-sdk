{
  "name": "@cteno/sdk",
  "version": "2.10.16",
  "description": "Run Cteno agents from Node.js. Bundles a local Cteno daemon per platform; no desktop app or account needed.",
  "type": "module",
  "license": "MIT",
  "author": "Cteno contributors",
  "homepage": "https://github.com/zalan159/cteno-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zalan159/cteno-sdk.git",
    "directory": "js"
  },
  "bugs": {
    "url": "https://github.com/zalan159/cteno-sdk/issues"
  },
  "keywords": [
    "cteno",
    "agent",
    "sdk",
    "llm",
    "ai-agent",
    "automation"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "node": "./dist/core.js"
    },
    "./discover": {
      "types": "./dist/discover.d.ts",
      "node": "./dist/discover.js"
    },
    "./daemon": {
      "types": "./dist/daemon.d.ts",
      "node": "./dist/daemon.js"
    },
    "./method-tiers": {
      "types": "./dist/method-tiers.d.ts",
      "default": "./dist/method-tiers.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "node": "./dist/node.js"
    },
    "./socketio": {
      "types": "./dist/socketio.d.ts",
      "default": "./dist/socketio.js"
    },
    "./package.json": "./package.json"
  },
  "cteno": {
    "minDaemonVersion": "2.10.9",
    "agentSpecMinDaemonVersion": "2.10.10",
    "platforms": [
      "darwin-arm64",
      "darwin-x64",
      "linux-x64",
      "win32-x64"
    ]
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "typescript": "^5.7.3"
  }
}
